# Placeholder template only. Copy to infra/.env (ignored by Git).
# Fill all three values locally or provide them as process environment variables.
# Never commit the populated file. There are no default credentials.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# POSTGRES_USER is the bootstrap administrator, not an application identity.
# Runtime and migration identities/extensions are delivered in T006.
# Host mapping is fixed in compose.yaml: 127.0.0.1:5435 -> postgres:5432.
# Do not use the occupied port 5434 or change containers from other projects.
